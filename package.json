{
  "name": "smart-doc-flow",
  "version": "0.1.0",
  "private": true,
  "description": "Smart Doc Flow unified FastAPI + React + Electron workspace",
  "author": "Smart Doc Flow Team",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev-all-fastapi.cjs",
    "dev:compat": "node scripts/dev-all-fastapi.cjs",
    "dev:fastapi": "node scripts/dev-all-fastapi.cjs",
    "dev:frontend": "npm --prefix frontend run dev -- --port 3000 --host 0.0.0.0",
    "dev:frontend:web": "npm --prefix frontend run dev -- --port 3000 --host 0.0.0.0",
    "dev:frontend:app": "npm --prefix frontend-app run dev -- --port 3002 --host 0.0.0.0",
    "dev:app": "node scripts/dev-app.cjs",
    "dev:backend": "python backend/run_service.py backend --reload",
    "dev:backend:compat": "python backend/run_service.py backend --reload",
    "dev:backend:fastapi": "python backend/run_service.py backend --reload",
    "dev:auth": "python backend/run_service.py gateway --reload",
    "dev:gateway": "python backend/run_service.py gateway --reload",
    "dev:module2": "python backend/run_service.py module2 --reload",
    "dev:module4": "python backend/run_service.py module4 --reload",
    "build": "npm run build:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "build:frontend:app": "npm --prefix frontend-app run build",
    "start": "python backend/run_service.py backend",
    "start:compat": "python backend/run_service.py backend",
    "start:fastapi": "python backend/run_service.py backend",
    "start:ready": "node scripts/wait-for-gateway.cjs",
    "start:backend": "python backend/run_service.py backend",
    "start:backend:compat": "python backend/run_service.py backend",
    "start:backend:fastapi": "python backend/run_service.py backend",
    "start:auth": "python backend/run_service.py gateway",
    "start:gateway": "python backend/run_service.py gateway",
    "start:module2": "python backend/run_service.py module2",
    "start:module4": "python backend/run_service.py module4",
    "wait:gateway": "node scripts/wait-for-gateway.cjs",
    "qa:module2:frontend": "npm --prefix frontend run module2:frontend-realistic",
    "qa:module2:assistant": "npm --prefix frontend run module2:assistant-check",
    "qa:module2:trace": "npm --prefix frontend run module2:trace-regression",
    "qa:module4:live": "npm --prefix frontend run module4:live-multidoc",
    "qa:live:workflow": "npm run wait:gateway && npm run qa:module2:frontend && npm run qa:module2:assistant && npm run qa:module4:live",
    "qa:live:workflow:smoke": "node scripts/run-live-workflow-smoke.cjs",
    "desktop:local": "npm run build && node scripts/start-electron-local.cjs",
    "desktop:dev": "node scripts/start-electron-dev.cjs",
    "desktop:clean": "node scripts/clean-desktop-output.cjs",
    "desktop:doctor": "node scripts/desktop-doctor.cjs",
    "desktop:smoke": "node scripts/desktop-smoke.cjs dist-electron backend",
    "desktop:smoke:electron": "node scripts/desktop-smoke.cjs dist-electron electron",
    "desktop:pack": "npm run desktop:clean && npm run build && electron-builder --config electron-builder.json --dir",
    "desktop:dist": "npm run desktop:clean && npm run build && electron-builder --config electron-builder.json",
    "ops:normalize-layout": "node scripts/normalize-runtime-layout.cjs",
    "ops:clean-backend-runtime-dirs": "node scripts/clean-backend-runtime-dirs.cjs"
  },
  "devDependencies": {
    "electron": "^41.0.3",
    "electron-builder": "^26.0.12"
  }
}
