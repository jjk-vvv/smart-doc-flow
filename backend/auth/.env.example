# Compatibility proxy only. The authoritative backend is FastAPI on port 3001.
AUTH_PORT=3003
AUTH_CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:5173
AUTH_COMPAT_PROXY_TIMEOUT_MS=180000

# Optional explicit target for the unified FastAPI backend.
# Defaults to http://127.0.0.1:${GATEWAY_PORT} and GATEWAY_PORT defaults to 3001.
# AUTH_COMPAT_TARGET_URL=http://127.0.0.1:3001
# GATEWAY_PORT=3001
