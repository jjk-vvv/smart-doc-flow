# OpenAI-compatible model gateway
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://your-openai-compatible-base-url/v1
OPENAI_MODEL=qwen-max
OPENAI_VISION_MODEL=qwen3-vl-plus
OPENAI_API_MODE=chat

# Optional image limits for Word/image extraction requests
OPENAI_MAX_IMAGES=12
OPENAI_MAX_IMAGE_BYTES=4194304

# Optional AI API call logging for debugging model requests.
# Logs API URL, sanitized request body, and raw response. API keys are never logged.
# Base64 file/image payloads are redacted by default to avoid huge or sensitive logs.
MODULE3_AI_API_LOGGING_ENABLED=false
MODULE3_AI_API_LOG_MAX_CHARS=12000
MODULE3_AI_API_LOG_STRING_MAX_CHARS=3000
MODULE3_AI_API_LOG_INCLUDE_BASE64=false

# Optional PostgreSQL connection string.
# Leave empty if you want to run module3 without database persistence.
MODULE3_DATABASE_URL=postgresql+psycopg://username:password@localhost:5433/module3

# Owner isolation rollout mode:
# - compat_default: backward-compatible mode (legacy default-owner records can still be read)
# - strict_preferred: require explicit owner match when owner exists; missing owner metadata remains readable
# - strict_required: fully strict owner chain (request must carry owner identity)
MODULE3_OWNER_MODE=strict_required

# Bootstrap backfill for legacy metadata JSON records without owner_id.
MODULE3_OWNER_BACKFILL_ON_BOOT=true

# Legacy compatibility alias.
# If MODULE3_OWNER_MODE is omitted, MODULE3_OWNER_COMPAT_FALLBACK=0 maps to strict_required.
MODULE3_OWNER_COMPAT_FALLBACK=0

# Strict-mode rollback switch (temporary migration only):
# - 0 (recommended): strict_required requires authenticated owner headers
# - 1: allow owner_id / x-tenant-id fallback when authenticated owner headers are missing
MODULE3_OWNER_STRICT_ALLOW_LEGACY_IDENTITY=0

# Optional explicit storage directory override.
# If omitted, managed runtime uses runtime-data/module3/storage.
# MODULE3_STORAGE_DIR=

# Preview behavior. 0 means no truncation.
PREVIEW_LINE_LIMIT=0
PREVIEW_CHAR_LIMIT=0
