MODULE1_PORT=5000
MODULE1_MAX_FILE_MB=20

# OpenAI-compatible LLM endpoint for module1
MODULE1_LLM_BASE_URL=https://jeniya.cn/v1
MODULE1_LLM_MODEL=glm-4.6

# If the provider needs a separate multimodal model, set it explicitly.
# Otherwise it will default to MODULE1_LLM_MODEL.
MODULE1_LLM_VISION_MODEL=glm-4.6

# This is now a soft warning threshold, not an immediate failure threshold.
MODULE1_ANALYSIS_FIRST_TOKEN_TIMEOUT_SEC=18

# Hard timeout for a full analysis request. Only after this deadline will
# module1 fall back to the local summary.
MODULE1_ANALYSIS_HARD_TIMEOUT_SEC=180

# Configure the real key locally. Do not commit secrets.
MODULE1_LLM_API_KEY=
