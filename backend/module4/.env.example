MODULE4_DATABASE_DSN=postgresql://postgres:postgres@localhost:5433/Knowledge_Graph
MODULE4_CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:5173
MODULE4_DEFAULT_TENANT=default
MODULE4_ALERT_LOW_CONF_THRESHOLD=0.55
MODULE4_DB_CONNECT_TIMEOUT_SEC=3
MODULE4_DB_SCHEMA_TIMEOUT_SEC=8
MODULE4_STARTUP_TIMEOUT_SEC=20
MODULE4_RECOVERY_TIMEOUT_SEC=8
MODULE4_FORCE_MEMORY_MODE=0

# GraphRAG / OneAPI runtime
MODULE4_GRAPHRAG_API_BASE=http://127.0.0.1:3100/v1
# For providers that expose a web homepage at the root domain, be sure to use the
# actual OpenAI-compatible API prefix, for example:
# MODULE4_GRAPHRAG_API_BASE=https://jeniya.cn/v1
MODULE4_GRAPHRAG_CHAT_API_KEY=<your-chat-api-key>
MODULE4_GRAPHRAG_CHAT_MODEL=qwen-turbo
MODULE4_GRAPHRAG_EMBEDDING_API_KEY=<your-embedding-api-key>
MODULE4_GRAPHRAG_EMBEDDING_MODEL=text-embedding-v1
MODULE4_GRAPHRAG_ENTITY_TYPES=organization,person,geo,event,policy,indicator,facility,material,project,agreement
MODULE4_GRAPHRAG_PROMPTS_ROOT=assets/prompts
MODULE4_GRAPHRAG_WORKSPACES_ROOT=workspaces
MODULE4_GRAPHRAG_EXTRACT_GRAPH_PROMPT_FILE=extract_graph.txt
MODULE4_GRAPHRAG_SUMMARIZE_DESCRIPTIONS_PROMPT_FILE=summarize_descriptions.txt
MODULE4_GRAPHRAG_EXTRACT_CLAIMS_PROMPT_FILE=extract_claims.txt
MODULE4_GRAPHRAG_COMMUNITY_REPORT_GRAPH_PROMPT_FILE=community_report_graph.txt
MODULE4_GRAPHRAG_COMMUNITY_REPORT_TEXT_PROMPT_FILE=community_report_text.txt
MODULE4_GRAPHRAG_LOCAL_SEARCH_PROMPT_FILE=local_search_system_prompt.txt
MODULE4_GRAPHRAG_GLOBAL_SEARCH_MAP_PROMPT_FILE=global_search_map_system_prompt.txt
MODULE4_GRAPHRAG_GLOBAL_SEARCH_REDUCE_PROMPT_FILE=global_search_reduce_system_prompt.txt
MODULE4_GRAPHRAG_GLOBAL_SEARCH_KNOWLEDGE_PROMPT_FILE=global_search_knowledge_system_prompt.txt
MODULE4_GRAPHRAG_DRIFT_SEARCH_PROMPT_FILE=drift_search_system_prompt.txt
MODULE4_GRAPHRAG_DRIFT_REDUCE_PROMPT_FILE=drift_search_reduce_prompt.txt
MODULE4_GRAPHRAG_BASIC_SEARCH_PROMPT_FILE=basic_search_system_prompt.txt
MODULE4_GRAPHRAG_QUESTION_GEN_PROMPT_FILE=question_gen_system_prompt.txt
MODULE4_GRAPHRAG_INPUT_DIR=input
MODULE4_GRAPHRAG_CACHE_DIR=cache
MODULE4_GRAPHRAG_STORAGE_DIR=output/${timestamp}/artifacts
MODULE4_GRAPHRAG_REPORTING_DIR=output/${timestamp}/reports
MODULE4_GRAPHRAG_MAX_TOKENS=4000
MODULE4_GRAPHRAG_CHUNK_SIZE=1200
MODULE4_GRAPHRAG_CHUNK_OVERLAP=100
MODULE4_GRAPHRAG_INDEXING_METHOD=standard
# Optional: comma-separated explicit workflow override.
# When empty, GraphRAG default workflows are used.
MODULE4_GRAPHRAG_WORKFLOWS=
# Optional: comma-separated workflows to skip.
MODULE4_GRAPHRAG_SKIP_WORKFLOWS=
# Keep strict GraphRAG behavior by default.
# 0: fail on community-report workflow errors (recommended, GraphRAG-aligned)
# 1: retry once with community-report workflow skipped (compatibility fallback)
MODULE4_GRAPHRAG_RETRY_SKIP_COMMUNITY_REPORTS=0
# Optional: override module2 artifact root used to load assistant_1_source/*.md
# and assistant_payload/*.json when building module4 text corpus.
MODULE4_MODULE2_ARTIFACT_ROOT=
MODULE4_GRAPHRAG_CLUSTER_MAX_SIZE=10
MODULE4_GRAPHRAG_UTILS_PORT=8012
# Keep this generic unless you intentionally need a custom runtime.
# When set to `python`, Module 4 will auto-resolve to the repo-root
# `.venv-module4-py311`.
MODULE4_GRAPHRAG_PYTHON_BIN=python
# GraphRAG config style:
# - v3: align with original GraphRAG 3.x workflow and artifact naming
# - legacy: keep older module4 compatibility config shape
MODULE4_GRAPHRAG_CONFIG_STYLE=v3
# GraphRAG execution mode:
# - graphrag: run native GraphRAG CLI/index pipeline (production default)
# - deterministic_local: build deterministic local artifacts without remote model calls
MODULE4_GRAPHRAG_EXECUTION_MODE=graphrag
# Optional: point to source checkout (for editable package resolution during migration).
MODULE4_GRAPHRAG_SOURCE_REPO_ROOT=D:/GraphRAG/graphrag
MODULE4_GRAPHRAG_USE_SOURCE_CHECKOUT=1
MODULE4_GRAPHRAG_INDEX_TIMEOUT_SEC=7200
# Query timeout controls (seconds):
# - Set to 0 or empty to disable timeout for a mode.
# - Mode-specific value overrides shared value.
MODULE4_GRAPHRAG_QUERY_TIMEOUT_SEC=
MODULE4_GRAPHRAG_QUERY_TIMEOUT_BASIC_SEC=120
MODULE4_GRAPHRAG_QUERY_TIMEOUT_LOCAL_SEC=120
MODULE4_GRAPHRAG_QUERY_TIMEOUT_GLOBAL_SEC=180
MODULE4_GRAPHRAG_QUERY_TIMEOUT_DRIFT_SEC=90
# Keep GraphRAG failure semantics strict by default.
# 0: index failure stops ingest and surfaces diagnostics (recommended, GraphRAG-aligned)
# 1: allow partial artifact import as emergency fallback
MODULE4_GRAPHRAG_ALLOW_PARTIAL_IMPORT=0
# Keep document fallback graph disabled by default.
# 0: keep strict GraphRAG-first semantics
# 1: allow deterministic document-level fallback graph on ingest exceptions
MODULE4_INGEST_ALLOW_DOCUMENT_FALLBACK=0

# Neo4j runtime
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-neo4j-password>
NEO4J_DATABASE=neo4j
MODULE4_NEO4J_PROJECT_ON_READY=1
MODULE4_NEO4J_PROJECT_MAX_NODES=5000
MODULE4_NEO4J_PROJECT_MAX_EDGES=10000
MODULE4_NEO4J_PROJECT_TIMEOUT_SEC=2
