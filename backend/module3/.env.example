# OpenAI-compatible model gateway
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://your-openai-compatible-base-url/v1
OPENAI_MODEL=gpt-5.4
OPENAI_API_MODE=responses

# Optional image limits for Word/image extraction requests
OPENAI_MAX_IMAGES=12
OPENAI_MAX_IMAGE_BYTES=4194304

# Optional PostgreSQL connection string.
# Leave empty if you want to run module3 without database persistence.
MODULE3_DATABASE_URL=postgresql+psycopg://username:password@localhost:5433/module3

# Preview behavior. 0 means no truncation.
PREVIEW_LINE_LIMIT=0
PREVIEW_CHAR_LIMIT=0
