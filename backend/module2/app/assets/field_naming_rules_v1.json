{
  "version": "field-naming-rules-v1",
  "forbidden_aliases": [
    "result",
    "result_value",
    "value",
    "data",
    "content",
    "text",
    "name",
    "label",
    "table",
    "figure",
    "page",
    "字段",
    "结果",
    "结果值",
    "数据",
    "内容",
    "名称",
    "标签",
    "表格",
    "图片",
    "图",
    "页码",
    "说明",
    "左轴",
    "右轴"
  ],
  "templates": [
    {
      "name": "government_statistical_bulletin",
      "match_any": [
        "统计公报",
        "统计年鉴",
        "民政",
        "最低生活保障",
        "福利彩票",
        "结婚登记",
        "离婚登记",
        "火化率"
      ]
    },
    {
      "name": "chemical_process_experiment",
      "match_any": [
        "tbp",
        "dfru",
        "runo",
        "萃取",
        "洗涤段",
        "进料段",
        "相对流量",
        "络合物"
      ]
    },
    {
      "name": "scientific_appendix_exercise",
      "match_any": [
        "appendix",
        "answers to exercises",
        "exercise",
        "isotope",
        "particle",
        "physical property"
      ]
    },
    {
      "name": "xlsx_business_ledger",
      "match_any": [
        ".xlsx",
        "销售额",
        "销量",
        "sku",
        "订单",
        "店铺",
        "商品"
      ]
    }
  ],
  "units": [
    {
      "norm": "percent",
      "label": "%",
      "tokens": ["%", "％", "百分比"],
      "strip_tokens": ["(%)", "（%）", "/%", "％", "%", "百分比"]
    },
    {
      "norm": "ten_thousand_people",
      "label": "万人",
      "tokens": ["万人"],
      "strip_tokens": ["(万人)", "（万人）", "万人"]
    },
    {
      "norm": "ten_thousand_pairs",
      "label": "万对",
      "tokens": ["万对"],
      "strip_tokens": ["(万对)", "（万对）", "万对"]
    },
    {
      "norm": "ten_thousand_units",
      "label": "万个",
      "tokens": ["万个"],
      "strip_tokens": ["(万个)", "（万个）", "万个"]
    },
    {
      "norm": "ten_thousand_beds",
      "label": "万张",
      "tokens": ["万张"],
      "strip_tokens": ["(万张)", "（万张）", "万张"]
    },
    {
      "norm": "ten_thousand_cny",
      "label": "万元",
      "tokens": ["万元"],
      "strip_tokens": ["(万元)", "（万元）", "万元"]
    },
    {
      "norm": "hundred_million_cny",
      "label": "亿元",
      "tokens": ["亿元"],
      "strip_tokens": ["(亿元)", "（亿元）", "亿元"]
    },
    {
      "norm": "mol_per_l",
      "label": "mol/L",
      "tokens": ["mol/l", "mol·l^-1", "mol l-1"],
      "strip_tokens": ["mol/l", "mol·l^-1", "mol l-1"]
    },
    {
      "norm": "g_per_l",
      "label": "g/L",
      "tokens": ["g/l", "g·l^-1", "g l-1"],
      "strip_tokens": ["g/l", "g·l^-1", "g l-1"]
    }
  ],
  "dimensions": {
    "region_type": [
      { "value": "urban", "label": "城市", "tokens": ["城市", "城镇", "urban"] },
      { "value": "rural", "label": "农村", "tokens": ["农村", "乡村", "rural"] }
    ],
    "stream": [
      { "value": "af", "label": "AF", "tokens": [" af", "(af)", "（af）", "af"] },
      { "value": "as", "label": "AS", "tokens": [" as", "(as)", "（as）", "as"] },
      { "value": "sf", "label": "SF", "tokens": [" sf", "(sf)", "（sf）", "sf"] },
      { "value": "of", "label": "OF", "tokens": [" of", "(of)", "（of）", "of"] }
    ],
    "stage": [
      { "value": "overall", "label": "总体", "tokens": ["总的", "总体", "合计", "总计", "overall", "total"] },
      { "value": "feed", "label": "进料段", "tokens": ["进料段", "进料", "feed"] },
      { "value": "wash", "label": "洗涤段", "tokens": ["洗涤段", "洗涤", "wash"] },
      { "value": "extraction", "label": "萃取段", "tokens": ["萃取段", "萃取", "extract"] },
      { "value": "stripping", "label": "反萃段", "tokens": ["反萃段", "反萃", "strip"] }
    ],
    "age_band": [
      { "value": "60_plus", "label": "60岁及以上", "tokens": ["60周岁及以上", "60岁及以上", "60岁以上", "60+"] },
      { "value": "65_plus", "label": "65岁及以上", "tokens": ["65周岁及以上", "65岁及以上", "65岁以上", "65+"] }
    ],
    "basis": [
      { "value": "volume_fraction", "label": "体积分数", "tokens": ["体积分数", "volume fraction"] },
      { "value": "mass_fraction", "label": "质量分数", "tokens": ["质量分数", "mass fraction", "wt%"] }
    ]
  },
