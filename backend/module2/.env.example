MODULE2_DATABASE_DSN=postgresql://postgres:postgres@localhost:5432/a23
MODULE2_CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:5173

# Upload / parsing safety limits
MODULE2_MAX_FILE_MB=25
MODULE2_PARSE_TIMEOUT_SEC=120
MODULE2_EXTRACT_TIMEOUT_SEC=120
MODULE2_BATCH_CONCURRENCY=2
MODULE2_MAX_RETRIES=2

# Storage behavior
MODULE2_FAIL_ON_STAGING_PARTIAL=true

# Parsing coverage (increase for long reports/books)
MODULE2_MAX_PARSE_PAGES=240
MODULE2_MAX_PARSE_PAGES_VISUAL=960

# Table extraction capacity
MODULE2_TABLE_MAX_ROWS=200
MODULE2_TABLE_MAX_COLS=32
MODULE2_TABLE_CELL_CAP=12000

# LLM context window for grounding refs
MODULE2_ALLOWED_REFS_MAX=1200
MODULE2_TABLE_ALLOWED_REFS_MAX=1200
MODULE2_PROMPT_MAX_CHARS=32000
MODULE2_TABLE_CONTEXT_MAX_TABLES=8
MODULE2_TABLE_CONTEXT_MAX_ROWS=24
MODULE2_TABLE_CONTEXT_MAX_COLS=12
MODULE2_TABLE_CONTEXT_MAX_HEADER_META=12

# OCR/image
MODULE2_IMAGE_OCR_DPI=180
MODULE2_OCR_FRONT_SCAN_PAGES=72

# Gemini Vision secondary enhancement for low-quality OCR pages
GOOGLE_API_KEY=
MODULE2_ENABLE_GEMINI_VISION_ENHANCE=true
MODULE2_GEMINI_VISION_MODEL=gemini-2.5-flash
MODULE2_GEMINI_VISION_TIMEOUT_SEC=25
MODULE2_GEMINI_VISION_DPI=150
MODULE2_GEMINI_VISION_MAX_SIDE_PX=1800
MODULE2_GEMINI_VISION_MAX_PAGES=24
MODULE2_GEMINI_VISION_MAX_TABLES_PER_PAGE=5
MODULE2_GEMINI_VISION_ENABLE_FIGURES=true
MODULE2_GEMINI_VISION_MAX_FIGURES_PER_PAGE=8
MODULE2_GEMINI_VISION_MIN_TABLE_QUALITY=0.72
MODULE2_GEMINI_VISION_MIN_FIGURE_QUALITY=0.56
MODULE2_GEMINI_VISION_MAX_OUTPUT_TOKENS=4096
MODULE2_GEMINI_VISION_CONSECUTIVE_FAIL_STOP=2

# Visual-first pipeline (MinerU locate/crop + Gemini understanding)
MODULE2_PIPELINE_MODE=visual_first
MODULE2_ENABLE_MINERU_LAYOUT=true
MODULE2_VISUAL_FIRST_ALLOW_LEGACY_FALLBACK=true
MODULE2_VISUAL_FIRST_MAX_PAGES=120
MODULE2_VISUAL_FIRST_MAX_PAGES_SCANNED=72
MODULE2_VISUAL_MAX_OBJECTS=220
MODULE2_VISUAL_TABLE_MAX_PER_PAGE=6
MODULE2_VISUAL_FIGURE_MAX_PER_PAGE=8
MODULE2_VISUAL_TABLE_MIN_CONFIDENCE=0.45
MODULE2_VISUAL_FIGURE_MIN_CONFIDENCE=0.35
MODULE2_VISUAL_CONTEXT_MAX_CHARS=2400
MODULE2_VISUAL_USE_TABLE_HTML_FALLBACK=true

# MinerU execution
MODULE2_MINERU_BACKEND=pipeline
MODULE2_MINERU_METHOD=txt
MODULE2_MINERU_SCANNED_METHOD=txt
MODULE2_MINERU_TIMEOUT_SEC=3600
MODULE2_MINERU_CACHE_DIR=backend/module2/.cache/mineru
MODULE2_MINERU_ENABLE_CACHE=true
MODULE2_MINERU_ENABLE_FORMULA=false
MODULE2_MINERU_ENABLE_TABLE=true

# ROI crop quality/speed knobs
MODULE2_VISUAL_TABLE_CROP_DPI=260
MODULE2_VISUAL_FIGURE_CROP_DPI=220
MODULE2_VISUAL_CROP_EXPAND_RATIO=0.03
MODULE2_VISUAL_CROP_MAX_SIDE_PX=2800

# Gemini ROI cache and retry
MODULE2_VISUAL_VISION_RETRY_COUNT=1
MODULE2_GEMINI_CACHE_DIR=backend/module2/.cache/gemini
MODULE2_GEMINI_CACHE_ENABLE=true
