# Unified FastAPI backend authoritative configuration.
# Copy the values you actually use into backend/.env when you are ready to
# converge the main backend configuration away from legacy module folders.

# Core gateway
# Unified dev ports
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
FRONTEND_APP_HOST=0.0.0.0
FRONTEND_APP_PORT=3002
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3001
MODULE2_HOST=0.0.0.0
# Keep 8010 aligned with current gateway upstream default.
MODULE2_PORT=8010
MODULE3_HOST=0.0.0.0
MODULE3_PORT=8001
MODULE4_HOST=0.0.0.0
MODULE4_PORT=8100
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3010,http://127.0.0.1:3010,http://localhost:3011,http://127.0.0.1:3011,http://localhost:5173,http://127.0.0.1:5173,http://localhost:19006,http://127.0.0.1:19006,http://localhost:19007,http://127.0.0.1:19007,http://localhost:19008,http://127.0.0.1:19008
GATEWAY_REQUEST_TIMEOUT_SEC=300
GATEWAY_HEALTH_PROBE_TIMEOUT_SEC=2
GATEWAY_STARTUP_SIDECAR_GRACE_SEC=5
GATEWAY_STREAM_CHUNK_SIZE=4096
# Optional unified registration mode for module3 routes:
# - auto: try to register, skip on import/runtime dependency failure (default)
# - disabled: do not register module3 routes in unified gateway
# - required: fail gateway startup if module3 routes cannot be registered
UNIFIED_GATEWAY_MODULE3_ROUTER_MODE=auto

# Optional runtime roots for packaging
# SMART_DOC_FLOW_RUNTIME_ROOT=
# SMART_DOC_FLOW_CONFIG_ROOT=
# SMART_DOC_FLOW_DATA_ROOT=runtime-data
# GATEWAY_FRONTEND_DIST_DIR=

# Unified auth
AUTH_SECRET_KEY=replace_with_a_long_random_secret
AUTH_TOKEN_EXPIRES_IN=7d
AUTH_COOKIE_NAME=token
AUTH_COOKIE_MAX_AGE_DAYS=7
AUTH_PASSWORD_SALT_ROUNDS=10
AUTH_DATABASE_ENABLED=true
# If omitted, auth will fall back to MODULE4_DATABASE_DSN when available and
# create/use the dedicated AUTH_DATABASE_SCHEMA inside that PostgreSQL database.
# AUTH_DATABASE_DSN=postgresql://postgres:postgres@127.0.0.1:5433/Knowledge_Graph
AUTH_DATABASE_SCHEMA=auth
AUTH_DB_CONNECT_TIMEOUT_SEC=3
AUTH_DB_SCHEMA_TIMEOUT_SEC=8
AUTH_DB_POOL_MIN_SIZE=1
AUTH_DB_POOL_MAX_SIZE=10
AUTH_TENANT_MODE=compat_default
AUTH_TENANT_DEFAULT_ID=default
# AUTH_TENANT_MODE options:
# - compat_default: preserve current legacy/default workspace visibility
# - user_preferred: prefer logged-in user tenant when no explicit tenant is provided
# - user_strict: force authenticated user tenant and reject mismatched tenant requests
# Do not switch to user_strict until your historical default-tenant data has been migrated.
AUTH_VERIFY_CODE_EXPIRES_MS=300000
AUTH_SEND_CODE_WINDOW_MS=600000
AUTH_SEND_CODE_MAX_PER_CONTACT=5
AUTH_SEND_CODE_MAX_PER_IP=20
AUTH_SEND_CODE_COOLDOWN_MS=60000
AUTH_LOGIN_FAILURE_WINDOW_MS=900000
AUTH_LOGIN_MAX_FAILURES_PER_ACCOUNT=5
AUTH_LOGIN_MAX_FAILURES_PER_IP=20
AUTH_LOGIN_LOCK_MS=900000
# Optional explicit users storage path. By default this resolves to
# ${SMART_DOC_FLOW_DATA_ROOT}/auth/users.json or runtime-root/auth/users.json.
# AUTH_USERS_FILE=

# Optional SMS (ihuyi)
# AUTH_SMS_PROVIDER=ihuyi
# AUTH_IHUYI_API_ID=
# AUTH_IHUYI_API_KEY=

# Optional SMTP for email verification
# AUTH_SMTP_HOST=smtp.example.com
# AUTH_SMTP_PORT=587
# AUTH_SMTP_SECURE=false
# AUTH_SMTP_USER=
# AUTH_SMTP_PASS=
# AUTH_SMTP_FROM="智能文档流转平台 <no-reply@example.com>"

# Unified assistant
ASSISTANT1_CHAT_API_KEY=
ASSISTANT1_CHAT_BASE_URL=https://api.openai.com
ASSISTANT1_CHAT_ENDPOINT_PATH=/v1/responses
ASSISTANT1_CHAT_ENDPOINT_STYLE=openai_responses
ASSISTANT1_CHAT_MODEL=gpt-5-mini
ASSISTANT1_CHAT_TEMPERATURE=0.2
ASSISTANT1_CHAT_TIMEOUT_SEC=120
ASSISTANT1_CHAT_MAX_OUTPUT_TOKENS=2400
ASSISTANT1_CHAT_REASONING_EFFORT=minimal
ASSISTANT1_CHAT_TEXT_VERBOSITY=medium
ASSISTANT1_CHAT_SMOKE_TEST_ENABLED=1
ASSISTANT1_CHAT_SMOKE_TEST_TTL_SEC=600
# AI_CHAT_EXTRA_PROMPT=

# Unified extraction / upstream routing
# Optional local port hint used when probing Module 2 local upstream candidates.
# MODULE2_PORT=8010
MODULE2_UPSTREAM_URL=http://127.0.0.1:8010
UNIFIED_EXTRACT_MODULE2_EXECUTION_MODE=upstream
UNIFIED_EXTRACT_MODULE2_FALLBACK_TO_UPSTREAM=true
UNIFIED_EXTRACT_MODULE2_WORKER_TIMEOUT_SEC=900
# UNIFIED_EXTRACT_MODULE2_WORKER_PYTHON=
UNIFIED_EXTRACT_MODULE2_SIDECAR_MODE=auto
UNIFIED_EXTRACT_MODULE2_SIDECAR_STARTUP_TIMEOUT_SEC=120
# UNIFIED_EXTRACT_MODULE2_SIDECAR_PYTHON=
MODULE4_UPSTREAM_URL=http://127.0.0.1:8100
MODULE2_MAX_FILE_MB=25
MODULE2_DOC_TO_PDF_ENABLE=true
MODULE2_SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
MODULE2_SOFFICE_PDF_EXPORT_FILTER=writer_pdf_Export
# Optional persistent base directory for isolated LibreOffice profiles.
# Leave empty to use the system temp directory.
# MODULE2_SOFFICE_PROFILE_ROOT_DIR=
MODULE2_WORD_TO_PDF_PREFERRED_BACKEND=libreoffice_only
MODULE2_OFFICE_PREVIEW_TIMEOUT_SEC=120
MODULE2_OFFICE_PREVIEW_JOB_TTL_SEC=1800
MODULE2_OFFICE_PREVIEW_JOB_CAP=240
MODULE2_EXTRACT_JOB_TTL_SEC=7200
MODULE2_EXTRACT_JOB_CAP=240
UNIFIED_EXTRACT_SHADOW_POLL_TIMEOUT_SEC=2700
UNIFIED_EXTRACT_SHADOW_POLL_INTERVAL_SEC=1.2
UNIFIED_EXTRACT_ASSISTANT1_MODE=upstream
UNIFIED_EXTRACT_ASSISTANT1_FALLBACK_TO_LEGACY=true
UNIFIED_EXTRACT_ASSISTANT1_CONTEXT_MAX_SOURCE_CHARS=12000
UNIFIED_EXTRACT_ASSISTANT1_CONTEXT_MAX_REFS=6
UNIFIED_EXTRACT_ASSISTANT1_HISTORY_WINDOW=12
# MODULE2_ARTIFACT_ROOT_DIR=

# If the same key still exists in backend/module2/.env during migration,
# the unified FastAPI gateway now treats backend/.env as the authoritative value.

# Module-specific advanced settings still live in:
# - backend/module2/.env
# - backend/module4/.env
# Compat-only proxy settings still live in:
# - backend/auth/.env
