# Unified FastAPI backend authoritative configuration.
# Copy the values you actually use into backend/.env when you are ready to
# converge the main backend configuration away from legacy module folders.

# Core gateway
# Unified dev ports
# Public backend traffic should use GATEWAY_PORT only.
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
FRONTEND_APP_HOST=0.0.0.0
FRONTEND_APP_PORT=3002
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3001
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3010,http://127.0.0.1:3010,http://localhost:3011,http://127.0.0.1:3011,http://localhost:5173,http://127.0.0.1:5173,http://localhost:19006,http://127.0.0.1:19006,http://localhost:19007,http://127.0.0.1:19007,http://localhost:19008,http://127.0.0.1:19008
GATEWAY_REQUEST_TIMEOUT_SEC=300
GATEWAY_HEALTH_PROBE_TIMEOUT_SEC=2
GATEWAY_STARTUP_SIDECAR_GRACE_SEC=5
GATEWAY_STREAM_CHUNK_SIZE=4096
# Optional unified registration mode for module3 routes:
# - auto: try to register, skip on import/runtime dependency failure
# - disabled: do not register module3 routes in unified gateway
# - required: fail gateway startup if module3 routes cannot be registered
UNIFIED_GATEWAY_MODULE3_ROUTER_MODE=required

# Optional runtime roots for packaging
# SMART_DOC_FLOW_RUNTIME_ROOT=
# SMART_DOC_FLOW_CONFIG_ROOT=
# SMART_DOC_FLOW_DATA_ROOT=runtime-data
# GATEWAY_FRONTEND_DIST_DIR=

# Unified auth
AUTH_SECRET_KEY=replace_with_a_long_random_secret
AUTH_ENFORCE_SECRET_KEY_IN_PRODUCTION=true
AUTH_SECRET_KEY_MIN_LENGTH=32
AUTH_TOKEN_EXPIRES_IN=7d
AUTH_COOKIE_NAME=token
AUTH_COOKIE_MAX_AGE_DAYS=7
AUTH_PASSWORD_SALT_ROUNDS=10
AUTH_DATABASE_ENABLED=true
# If omitted, auth will fall back to MODULE4_DATABASE_DSN when available and
# create/use the dedicated AUTH_DATABASE_SCHEMA inside that PostgreSQL database.
# AUTH_DATABASE_DSN=postgresql://postgres:postgres@127.0.0.1:5433/Knowledge_Graph
AUTH_DATABASE_SCHEMA=auth
AUTH_DB_CONNECT_TIMEOUT_SEC=3
AUTH_DB_SCHEMA_TIMEOUT_SEC=8
AUTH_DB_POOL_MIN_SIZE=1
AUTH_DB_POOL_MAX_SIZE=10
AUTH_TENANT_MODE=user_strict
AUTH_TENANT_DEFAULT_ID=default
# AUTH_TENANT_MODE options:
# - compat_default: preserve current legacy/default workspace visibility
# - user_preferred: prefer logged-in user tenant when no explicit tenant is provided
# - user_strict: force authenticated user tenant and reject mismatched tenant requests
# If you still have legacy default-tenant data, you can temporarily downgrade to:
# AUTH_TENANT_MODE=compat_default
# Strict-mode rollback switch (temporary migration only):
# - 0 (recommended): in user_strict mode, require authenticated tenant identity
# - 1: allow legacy fallback to explicit/header/default tenant sources
AUTH_TENANT_STRICT_ALLOW_LEGACY_FALLBACK=0
AUTH_VERIFY_CODE_EXPIRES_MS=300000
AUTH_SEND_CODE_WINDOW_MS=600000
AUTH_SEND_CODE_MAX_PER_CONTACT=5
AUTH_SEND_CODE_MAX_PER_IP=20
AUTH_SEND_CODE_COOLDOWN_MS=60000
AUTH_LOGIN_FAILURE_WINDOW_MS=900000
AUTH_LOGIN_MAX_FAILURES_PER_ACCOUNT=5
AUTH_LOGIN_MAX_FAILURES_PER_IP=20
AUTH_LOGIN_LOCK_MS=900000
AUTH_REQUIRE_SESSION_ID_IN_DB_MODE=true
# Optional explicit users storage path. By default this resolves to
# ${SMART_DOC_FLOW_DATA_ROOT}/auth/users.json or runtime-root/auth/users.json.
# AUTH_USERS_FILE=

# Optional SMS (ihuyi)
# AUTH_SMS_PROVIDER=ihuyi
# AUTH_IHUYI_API_ID=
# AUTH_IHUYI_API_KEY=

# Optional SMTP for email verification
# AUTH_SMTP_HOST=smtp.example.com
# AUTH_SMTP_PORT=587
# AUTH_SMTP_SECURE=false
# AUTH_SMTP_USER=
# AUTH_SMTP_PASS=
# AUTH_SMTP_FROM="智能文档流转平台 <no-reply@example.com>"

# Unified assistant
PLATFORM_ASSISTANT_API_KEY=
PLATFORM_ASSISTANT_BASE_URL=https://api.openai.com
PLATFORM_ASSISTANT_ENDPOINT_PATH=/v1/responses
PLATFORM_ASSISTANT_ENDPOINT_STYLE=openai_responses
PLATFORM_ASSISTANT_MODEL=gpt-5-mini
PLATFORM_ASSISTANT_TEMPERATURE=0.2
PLATFORM_ASSISTANT_TIMEOUT_SEC=120
PLATFORM_ASSISTANT_MAX_OUTPUT_TOKENS=2400
PLATFORM_ASSISTANT_REASONING_EFFORT=minimal
PLATFORM_ASSISTANT_TEXT_VERBOSITY=medium
PLATFORM_ASSISTANT_SMOKE_TEST_ENABLED=1
PLATFORM_ASSISTANT_SMOKE_TEST_TTL_SEC=600
# PLATFORM_ASSISTANT_EXTRA_PROMPT=
# Platform assistant reads PLATFORM_ASSISTANT_* only.

# Unified extraction / upstream routing
UNIFIED_EXTRACT_MODULE2_EXECUTION_MODE=subprocess
UNIFIED_EXTRACT_MODULE2_SIDECAR_MODE=disabled
UNIFIED_EXTRACT_ASSISTANT1_MODE=native
UNIFIED_EXTRACT_MODULE2_FALLBACK_TO_UPSTREAM=0
UNIFIED_GATEWAY_MODULE4_SIDECAR_MODE=disabled
MODULE2_MODULE4_BASE_URL=http://127.0.0.1:3001
# Module2 -> Module4 sync tenant guard:
# - compat_default: allow explicit/header/default fallback
# - authenticated_required: require authenticated tenant headers for sync routing
MODULE2_MODULE4_TENANT_GUARD_MODE=authenticated_required
# Legacy module2 import fallback switch during migration:
# - false (recommended): use unified app.modules.module2 paths only
# - true: allow temporary fallback to legacy module2.app paths
UNIFIED_EXTRACT_MODULE2_LEGACY_IMPORT_FALLBACK=false
# Legacy module2 API compat shims:
# - 0 (recommended): disable deprecated compat router builders by default
# - 1: temporarily re-enable deprecated compat router builders during rollback
MODULE2_API_COMPAT_ENABLED=0
UNIFIED_EXTRACT_MODULE2_WORKER_TIMEOUT_SEC=900
# UNIFIED_EXTRACT_MODULE2_WORKER_PYTHON=
# Legacy module4 API compat shim:
# - 0 (recommended): disable deprecated compat router builder by default
# - 1: temporarily re-enable deprecated compat router builder during rollback
MODULE4_API_COMPAT_ENABLED=0
# Module4 direct-request tenant guard:
# - compat_default: legacy fallback when authenticated headers are absent
# - authenticated_required: force authenticated tenant headers on module4 data APIs
MODULE4_TENANT_GUARD_MODE=authenticated_required
# Module4 sidecar internal access token guard:
# - off: disable token validation (default for compatibility)
# - required: enforce X-Module4-Internal-Token on module4 APIs
MODULE4_INTERNAL_TOKEN_MODE=off
MODULE4_INTERNAL_TOKEN=
MODULE2_MAX_FILE_MB=25
MODULE2_DOC_TO_PDF_ENABLE=true
MODULE2_SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
MODULE2_SOFFICE_PDF_EXPORT_FILTER=writer_pdf_Export
# Optional persistent base directory for isolated LibreOffice profiles.
# Leave empty to use the system temp directory.
# MODULE2_SOFFICE_PROFILE_ROOT_DIR=
MODULE2_WORD_TO_PDF_PREFERRED_BACKEND=libreoffice_only
MODULE2_OFFICE_PREVIEW_TIMEOUT_SEC=120
MODULE2_OFFICE_PREVIEW_JOB_TTL_SEC=1800
MODULE2_OFFICE_PREVIEW_JOB_CAP=240
MODULE2_EXTRACT_JOB_TTL_SEC=7200
MODULE2_EXTRACT_JOB_CAP=240
UNIFIED_EXTRACT_SHADOW_POLL_TIMEOUT_SEC=2700
UNIFIED_EXTRACT_SHADOW_POLL_INTERVAL_SEC=1.2
UNIFIED_EXTRACT_ASSISTANT1_FALLBACK_TO_LEGACY=true
UNIFIED_EXTRACT_ASSISTANT1_CONTEXT_MAX_SOURCE_CHARS=12000
UNIFIED_EXTRACT_ASSISTANT1_CONTEXT_MAX_REFS=6
UNIFIED_EXTRACT_ASSISTANT1_HISTORY_WINDOW=12
UNIFIED_EXTRACT_JOB_TENANT_GUARD_MODE=strict
UNIFIED_EXTRACT_ARTIFACT_TENANT_GUARD_MODE=strict
# MODULE2_ARTIFACT_ROOT_DIR=

# If the same key still exists in backend/app/modules/module2/.env during migration,
# the unified FastAPI gateway now treats backend/.env as the authoritative value.

# Module-specific advanced settings still live in:
# - backend/app/modules/module1/.env
# - backend/app/modules/module2/.env
# - backend/app/modules/module3/.env
# - backend/app/modules/module4/.env
