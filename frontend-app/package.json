{
  "name": "smart-doc-flow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 0.0.0.0 --strictPort --force",
    "build": "npm run build:web",
    "build:web": "node ./scripts/build-safe.mjs",
    "build:native": "node ./scripts/build-safe.mjs --mode native",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host 0.0.0.0 --strictPort",
    "cap:doctor": "npx cap doctor",
    "cap:copy": "npm run build:native && npx cap copy",
    "cap:sync": "npm run build:native && npx cap sync",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "module2:realistic": "node ./e2e/deepread-batch-simulation.mjs",
    "module2:frontend-realistic": "node ./e2e/deepread-frontend-regression.mjs",
    "module2:text-regression": "node ./e2e/deepread-text-regression.mjs",
    "module2:assistant-check": "node ./e2e/deepread-assistant-streaming.mjs",
    "module2:trace-regression": "node ./e2e/deepread-trace-panel-regression.mjs",
    "module4:frontend-check": "node ./e2e/knowledge-nexus-frontend-check.mjs",
    "module4:live-multidoc": "node ./e2e/knowledge-nexus-live-multidoc.mjs"
  },
  "dependencies": {
    "@antv/g6": "^5.1.0",
    "@capacitor/core": "^8.3.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@neo4j-nvl/base": "^1.1.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/d3-force": "^3.0.10",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "echarts": "^5.6.0",
    "framer-motion": "^12.34.0",
    "jquery": "^4.0.0",
    "lucide-react": "0.292.0",
    "luckyexcel": "^1.0.1",
    "luckysheet": "^2.1.13",
    "pdfjs-dist": "5.4.296",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-pdf": "^10.4.1",
    "react-window": "^1.8.10",
    "recharts": "2.12.0",
    "tailwind-merge": "^3.4.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/xlsx": "^0.0.35",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.24",
    "playwright": "^1.54.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
