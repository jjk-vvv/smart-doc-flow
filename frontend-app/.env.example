# frontend-app default web deployment settings
# Production web build serves under /m/
FRONTEND_APP_PUBLIC_BASE=/m/
VITE_BUILD_OUT_DIR=dist

# local dev ports
FRONTEND_APP_PORT=3002
GATEWAY_PORT=3001

# optional backend gateway override
VITE_BACKEND_ENTRY_URL=http://localhost:3001
# optional comma-separated backend failover list
# VITE_BACKEND_ENTRY_URL_FALLBACKS=http://backup-1:3001,http://backup-2:3001

# optional per-module overrides (normally you can keep these empty and rely on VITE_BACKEND_ENTRY_URL)
# VITE_MODULE1_API_URL=http://localhost:3001
# VITE_MODULE3_API_BASE=http://localhost:3001/module3
# VITE_MODULE2_API_BASE=http://localhost:3001

# native build notes:
# `npm run build:native` will default to:
# FRONTEND_APP_PUBLIC_BASE=/
# VITE_BUILD_OUT_DIR=dist-native
#
# For real mobile login/API calls, add a local `.env.native` file and set:
# VITE_BACKEND_ENTRY_URL=http://<your-public-gateway-host>:<port>
