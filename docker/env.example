# 复制到项目根目录，供 `docker compose` 做 ${变量} 替换：
#   cp docker/env.example .env
#
# 应用内「大段」配置（可选）：另见 docker/app.env.example → 复制为 docker/app.env（已 .gitignore）。
#
# 若不创建 .env，compose 使用内置演示默认值（生产环境务必改掉）。

POSTGRES_PASSWORD=change-me-postgres
NEO4J_PASSWORD=change-me-neo4j
AUTH_SECRET_KEY=replace_with_at_least_32_random_characters_hex
NODE_ENV=development
AUTH_ENFORCE_SECRET_KEY_IN_PRODUCTION=true
GATEWAY_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
GATEWAY_BASE_URL=http://127.0.0.1:3001
APP_PUBLISH_PORT=3001
APP_BASE_IMAGE=smart-doc-flow-runtime-base:bookworm
PLATFORM_ASSISTANT_API_KEY=
PLATFORM_ASSISTANT_BASE_URL=https://api.openai.com
