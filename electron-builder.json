{
  "appId": "com.smartdocflow.desktop",
  "productName": "SmartDocFlow",
  "asar": true,
  "icon": "icon.png",
  "directories": {
    "output": "dist-electron",
    "buildResources": "electron"
  },
  "files": [
    "electron/**/*",
    "package.json",
    "node_modules/**/*"
  ],
  "extraResources": [
    {
      "from": "backend",
      "to": "app-runtime/backend",
      "filter": [
        "**/*",
        "!**/__pycache__/**",
        "!**/*.pyc",
        "!**/*.pyo",
        "!**/.pytest_cache/**",
        "!**/.pytest_tmp/**",
        "!**/.ruff_cache/**",
        "!**/.mcache/**",
        "!**/.runlogs/**",
        "!**/.runtime/**",
        "!**/runlogs/**",
        "!**/artifacts/**",
        "!**/workspaces/**",
        "!**/trace_rois/**",
        "!**/tests/**",
        "!**/.codex-temp/**",
        "!**/.env",
        "!**/.env.*",
        "!**/*.log",
        "!README.md",
        "!requirements-dev.txt"
      ]
    },
    {
      "from": "frontend/dist",
      "to": "app-runtime/frontend/dist",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "scripts",
      "to": "app-runtime/scripts",
      "filter": [
        "**/*.cjs"
      ]
    },
    {
      "from": ".venv",
      "to": "app-runtime/.venv",
      "filter": [
        "**/*",
        "!**/__pycache__/**",
        "!**/*.pyc",
        "!**/*.pyo"
      ]
    }
  ],
  "win": {
    "icon": "icon.ico",
    "signAndEditExecutable": false,
    "target": [
      "dir",
      "nsis"
    ],
    "artifactName": "SmartDocFlow.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
